generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bhajan {
  id        Int       @id @default(autoincrement())
  title     String
  content   String    @db.Text
  author    String
  ownerId   String
  likes     Int       @default(0)
  createdAt DateTime  @default(now())
  comments  Comment[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String   @db.Text
  author    String
  ownerId   String
  createdAt DateTime @default(now())
  
  bhajanId  Int
  bhajan    Bhajan   @relation(fields: [bhajanId], references: [id], onDelete: Cascade)
}

model SpiritualBhajan {
  id            String   @id
  titleEnglish  String
  titleHindi    String
  deity         String
  type          String
  lyricsHindi   String[]
  lyricsEnglish String[]
  description   String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SpiritualBook {
  id          String            @id
  title       String
  author      String
  description String            @db.Text
  chapters    SpiritualChapter[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model SpiritualChapter {
  id            Int           @id @default(autoincrement())
  chapterNumber Int
  title         String
  description   String        @db.Text
  verses        Int
  bookId        String
  book          SpiritualBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, chapterNumber])
}

model SpiritualShloka {
  id                    String   @id
  source                String
  chapter               Int
  verse                 Int
  hindi                 String   @db.Text
  englishTransliteration String  @db.Text
  meaningEnglish        String   @db.Text
  meaningHindi          String   @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
